{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ermocodes-site",
  "compatibility_date": "2026-11-01",
  // Production is served only from the custom domain; PR previews use preview URLs.
  "workers_dev": false,
  "preview_urls": true,
  // Static assets only: no Worker script.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
  },
  "routes": [{ "pattern": "ermocodes.com", "custom_domain": true }],
}
