{
  // One-time bootstrap config (deploy.yml, workflow_dispatch). Same Worker as wrangler.jsonc but
  // with no routes, so the first `wrangler deploy` creates the Worker and enables preview URLs
  // without attaching the ermocodes.com apex. Keep the shared fields in sync with wrangler.jsonc.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ermocodes-site",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
  },
  "routes": [],
}
