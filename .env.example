# All optional; leave empty and the feature stays off. Production reads them from GitHub repo
# variables (deploy.yml).
# Cloudflare Web Analytics site token (cookieless beacon, production builds only).
PUBLIC_CF_BEACON_TOKEN=
# Cal.com event URL (https://cal.com/ermocodes/intro-call) or "username/event-slug"; [book a call] renders only when this is set.
PUBLIC_CAL_LINK=
